# ==========================================
#  PROJECT BEA - ENVIRONMENT CONFIGURATION
# ==========================================
#  This file serves as a template for your local .env file.
#  Copy this file to .env and fill in the values.
#  DO NOT commit your actual .env file to version control.
# ==========================================

# ------------------------------------------
# 1. CORE AI PROVIDERS (LLM)
# ------------------------------------------
# Default provider: OpenRouter (one endpoint, any model).

# OpenRouter (recommended — routes to GPT, Claude, Gemini, GLM, Llama, ...)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."
# Model id set in config.json, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet

# OpenAI (called directly)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Groq (Ultra-Fast Inference)
# Get key: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"


# ------------------------------------------
# 2. VOICE SYNTHESIS (TTS)
# ------------------------------------------

# Orpheus TTS (High Quality AI Voice)
# Get key: https://app.baseten.co/
ORPHEUS_API_KEY=""
# Endpoint for the deployed model
ORPHEUS_ENDPOINT=""
# Voice ID (e.g., "zoe", "isabella")
ORPHEUS_VOICE=""


# ------------------------------------------
# 3. DISCORD INTEGRATION
# ------------------------------------------

# Discord Bot Token
# Get token: https://discord.com/developers/applications
# Ensure intents are enabled: Message Content, Guilds, Voice States.
DISCORD_TOKEN="OTcw..."

# Port for the internal Discord Bot API
# Default: 3030
PORT=3030


# ------------------------------------------
# 4. MINECRAFT SKILL
# ------------------------------------------

# Minecraft Agent Logic Model
# Specific model for the agent (usually gpt-5-mini for cost/speed balance)
MC_OPENAI_MODEL="gpt-5-mini"

# Auto-Generated Thoughts
# If True, the agent will generate internal monologue for every chat message.
# Default: True
AUTO_CHAT_THOUGHTS=True

# Debug Mode
# Enable verbose logging for the agent state machine.
# Default: False
DEBUG_MODE=False

# Minecraft Server Connection
# URL of the websocket server (e.g., from the mod)
# Default: ws://127.0.0.1:8080
MC_SERVER_URL="ws://127.0.0.1:8080"


# ------------------------------------------
# 5. OBS STUDIO CONTROLLER
# ------------------------------------------
# Requires OBS WebSocket Server enabled in OBS Tools -> WebSocket Server Settings.

# OBS WebSocket Host (usually localhost)
OBS_HOST="localhost"

# OBS WebSocket Port (Default: 4455)
OBS_PORT=4455

# OBS WebSocket Password
# Leave empty if disable in OBS, but recommended to set one.
OBS_PASSWORD=""
